@startuml
!include _estilo.iuml
title Diagrama de despliegue — TejeRed en contenedores (red virtual "tejered")

node "Equipo cliente" as pc {
  artifact "Navegador / curl /\nloadtest.js" as cli
}

cloud "Nube (VM o clúster de contenedores)" {
  node "Contenedor gateway\n<<Docker: node:22-alpine>>" as cgw {
    artifact "gateway.js\n:3000" as agw
  }
  node "Contenedor broker\n<<Docker: node:22-alpine>>" as cbr {
    artifact "broker.js\n:4000" as abr
  }
  node "Contenedor worker 1..N\n<<Docker: node:22-alpine>>\n(docker compose --scale worker=N)" as cwk {
    artifact "worker-node.js\n:5001" as awk
    component "Pool de hilos\n(POOL_SIZE = 2)" as hilos
  }
}

cli --> agw : HTTPS/HTTP :3000\n(único puerto expuesto)
agw --> abr : HTTP/JSON keep-alive\nBROKER_URL
abr --> awk : HTTP POST /deliver
awk --> abr : register / heartbeat
awk ..> hilos

note bottom of cwk
  Escalado horizontal: cada réplica se registra sola
  en el broker; no hay que reconfigurar nada.
end note
note right of cbr
  Punto único de coordinación:
  en producción se replicaría
  (ver mejoras futuras).
end note
@enduml
